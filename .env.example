# ==================== MemoMind 环境变量示例 ====================
# 复制此文件为 .env 并修改

# ----- 应用配置 -----
APP_NAME=MemoMind
APP_ENV=dev                    # dev / prod
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----- 数据库 -----
DATABASE_URL=postgresql+psycopg2://memomind:memomind@localhost:5433/memomind

# ----- JWT -----
# 生产环境必须替换为随机强密钥: openssl rand -hex 32
JWT_SECRET_KEY=dev-secret-key-change-in-production-please-use-openssl-rand-hex-32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ----- AI Provider (可选, P1 阶段不用) -----
AI_PROVIDER=deepseek           # deepseek / dashscope
DEEPSEEK_API_KEY=sk-931733e48a9540cca946658761b16dc6
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ----- Redis (可选, P1 阶段不用) -----
REDIS_URL=redis://localhost:6379/0
