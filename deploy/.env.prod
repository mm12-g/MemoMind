# ============================================================
# MemoMind 生产环境变量
# 复制此文件为 .env 并填入真实值（部署时放在 deploy/ 目录下）
# ============================================================

# ----- 域名 -----
DOMAIN=your-domain.com

# ----- 端口 -----
FRONTEND_PORT=80

# ----- 应用 -----
APP_ENV=prod
CORS_ORIGINS=https://your-domain.com,http://your-domain.com

# ----- PostgreSQL（务必修改密码！）-----
POSTGRES_USER=memomind
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD_123
POSTGRES_DB=memomind

# ----- JWT 密钥（务必替换！）-----
# 生成方式: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET_KEY

# ----- AI API -----
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
